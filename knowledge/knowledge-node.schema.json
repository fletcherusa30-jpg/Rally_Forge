{
  "$schemaVersion": "1.0.0",
  "description": "Canonical schema for Rally Forge VA knowledge nodes (structural only; no copyrighted text).",
  "requiredFields": [
    "id",
    "domain",
    "authority",
    "citation",
    "title",
    "effectiveRange",
    "conditions",
    "requiredEvidence",
    "decisionLogic",
    "relatedNodes",
    "tags",
    "provenance"
  ],
  "fieldRules": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "domain": {
      "type": "string",
      "enum": [
        "service_connection",
        "rating",
        "exposure",
        "appeals",
        "effective_date",
        "evidence_development"
      ]
    },
    "authority": {
      "type": "string",
      "enum": ["cfr", "m21-1", "case_law", "policy"]
    },
    "citation": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "effectiveRange": {
      "type": "object",
      "requiredFields": ["start", "end"]
    },
    "conditions": { "type": "array" },
    "requiredEvidence": { "type": "array" },
    "decisionLogic": { "type": "array" },
    "relatedNodes": { "type": "array" },
    "tags": { "type": "array" },
    "provenance": {
      "type": "object",
      "requiredFields": ["file", "hash", "importedAt"]
    }
  }
}
