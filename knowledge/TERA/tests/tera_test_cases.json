    {
      "testId": "TERA-006",
      "description": "TERA with SBP and tax deductions",
      "input": {
        "serviceMember": {
          "id": "TEST-006",
          "name": {"first": "Michael", "middle": "F", "last": "Brown"},
          "branch": "Navy",
          "rank": {"paygrade": "E-7", "title": "Chief Petty Officer"},
          "dob": "1975-08-12"
        },
        "serviceRecord": {
          "entryDate": "2000-09-01",
          "retirementDate": "2016-09-01",
          "totalService": {
            "years": 16,
            "months": 0,
            "days": 0,
            "totalDays": 5840,
            "fractionalYears": 16.0
          },
          "high36": {
            "average": 4800.00
          }
        },
        "deductions": {
          "sbp": {
            "elected": true,
            "coverageLevel": "Spouse",
            "baseCoverage": 1920.00,
            "monthlyPremium": 124.80
          },
          "federalTax": {
            "withholdingStatus": "Married",
            "exemptions": 2,
            "additionalWithholding": 0
          },
          "stateTax": {
            "state": "CA",
            "withholdingAmount": 50.00
          }
        }
      },
      "expectedOutput": {
        "calculation": {
          "multiplier": 0.40,
          "high36Average": 4800.00,
          "monthlyPay": 1920.00,
          "annualPay": 23040.00
        },
        "deductions": {
          "sbp": {
            "monthlyPremium": 124.80,
            "annualPremium": 1497.60
          }
        },
        "netPay": {
          "monthlyNet": 1620.20,
          "annualNet": 19442.40,
          "note": "After SBP, federal and state tax withholding"
        }
      }
    },
