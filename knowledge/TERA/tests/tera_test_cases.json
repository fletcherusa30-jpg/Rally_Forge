{
  "testSuite": "TERA Retirement Calculation Tests",
  "version": "1.0.0",
  "description": "Test cases for TERA retirement pay calculations",
  "testCases": [
    {
      "testId": "TERA-001",
      "description": "E-7 with 15 years service - minimum TERA eligibility",
      "input": {
        "serviceMember": {
          "id": "TEST-001",
          "name": {"first": "John", "middle": "A", "last": "Smith"},
          "branch": "Army",
          "rank": {"paygrade": "E-7", "title": "Sergeant First Class"},
          "dob": "1976-01-15"
        },
        "serviceRecord": {
          "entryDate": "2006-01-15",
          "retirementDate": "2021-01-15",
          "totalService": {
            "years": 15,
            "months": 0,
            "days": 0,
            "totalDays": 5475,
            "fractionalYears": 15.0
          },
          "high36": {
            "average": 4500.00
          }
        }
      },
      "expectedOutput": {
        "calculation": {
          "multiplier": 0.375,
          "high36Average": 4500.00,
          "monthlyPay": 1687.50,
          "annualPay": 20250.00
        },
        "comparison": {
          "tera": {
            "years": 15,
            "monthlyPay": 1687.50,
            "annualPay": 20250.00
          },
          "fullRetirement": {
            "years": 20,
            "estimatedMonthlyPay": 2250.00,
            "estimatedAnnualPay": 27000.00
          },
          "difference": {
            "monthlyDifference": -562.50,
            "annualDifference": -6750.00,
            "percentageReduction": 25.0
          }
        }
      },
      "validationRules": [
        "multiplier === years_of_service * 0.025",
        "monthlyPay === high36Average * multiplier",
        "annualPay === monthlyPay * 12",
        "years_of_service >= 15 && years_of_service < 20"
      ]
    },
