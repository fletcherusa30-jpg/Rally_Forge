    {
      "testId": "TERA-008",
      "description": "Invalid - 20 or more years service",
      "input": {
        "serviceMember": {
          "id": "TEST-008",
          "name": {"first": "Invalid", "middle": "Test", "last": "Case2"},
          "branch": "Air Force",
          "rank": {"paygrade": "E-8", "title": "Senior Master Sergeant"},
          "dob": "1970-01-01"
        },
        "serviceRecord": {
          "entryDate": "1990-01-01",
          "retirementDate": "2010-02-01",
          "totalService": {
            "years": 20,
            "months": 1,
            "days": 0,
            "totalDays": 7335,
            "fractionalYears": 20.08
          },
          "high36": {
            "average": 5500.00
          }
        }
      },
      "expectedOutput": {
        "error": "Ineligible for TERA",
        "reason": "Service years (20.08) meets regular retirement eligibility (20+ years)",
        "recommendation": "Eligible for regular retirement instead",
        "validationFailed": true
      }
    }
  ],
  "validationRules": {
    "eligibility": {
      "minimumYears": 15.0,
      "maximumYears": 19.999,
      "allowedBranches": ["Army", "Navy", "Air Force", "Marine Corps"],
      "multiplierRate": 0.025
    },
    "calculations": {
      "formulas": {
        "multiplier": "years_of_service * 0.025",
        "monthlyPay": "high36Average * multiplier",
        "annualPay": "monthlyPay * 12",
        "sbp_premium": "baseCoverage * 0.065"
      }
    }
  }
}
