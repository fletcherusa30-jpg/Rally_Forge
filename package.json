{
  "name": "rally-forge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node tooling/scripts/dev-runner.mjs",
    "start:prod": "vite preview",
    "predev": "node tooling/scripts/free-dev-ports.mjs && node -e \"console.log('Starting Rally Forge dev environment...')\"",
    "dev": "node tooling/scripts/dev-runner.mjs",
    "dev:full": "node tooling/scripts/dev-runner.mjs --with-static",
    "dev:doctor": "node tooling/scripts/dev-doctor.mjs",
    "dev:web": "http-server app/frontend-modern -p 5174 -c-1",
    "dev:api": "node backend/server.js",
    "dev:react": "vite",
    "build": "vite build",
    "build:check": "npm run build && node -e \"console.log('✅ Build successful')\"",
    "preview": "vite preview",
    "test": "echo 'Running all tests...' && npm run test:strs-engine && npm run test:strs-integration && npm run test:compensation && npm run test:dependents",
    "test:strs-engine": "node --test backend/tests/strs-engine.test.js",
    "test:strs-integration": "node --test backend/tests/strs-integration.test.js",
    "test:api-smoke": "node --test backend/tests/api-smoke.test.js",
    "test:pattern": "node tests/test-pattern-match.js",
    "test:onboarding-flow": "node tooling/scripts/verify-onboarding-flow.mjs",
    "test:compensation": "node --test backend/tests/compensation-regression.test.js",
    "test:dependents": "node --test backend/tests/dependent-calculation.test.js",
    "audit:refs": "node tooling/scripts/audit-missing-refs.mjs",
    "validate:rate-database": "node \"knowledge/RATE_DATABASE/MANIFESTS/validate-rate-database.mjs\"",
    "validate:rate-database:strict": "node \"knowledge/RATE_DATABASE/MANIFESTS/validate-rate-database.mjs\" --strict",
    "validate:all": "npm run lint && npm run build:check && npm test && npm run test:scanner-regression && npm run test:onboarding-flow && npm run validate:rate-database:strict",
    "audit:security": "npm audit --production",
    "lint": "eslint src backend --ext .js,.jsx --max-warnings 100",
    "lint:fix": "eslint src backend --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs=require('fs'); ['dist','node_modules','package-lock.json'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}})\"",
    "clean:build": "node -e \"const fs=require('fs'); try{fs.rmSync('dist',{recursive:true,force:true});}catch{}\"",
    "validate": "npm run format:check && npm run build:check",
    "sep:validate": "node docs/spd_engine/validate_inputs.js",
    "sep:extract": "node docs/spd_engine/run_extract.js",
    "test:scanner-regression": "node --test tests/combined_rating/combined_rating.regression.test.js tests/denial_reasons/denial_reasons.regression.test.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "http-server": "^14.1.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.10.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "prop-types": "^15.8.1",
    "redis": "^5.11.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  }
}
