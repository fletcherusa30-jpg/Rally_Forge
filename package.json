{
  "name": "rally-forge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "prestart": "node tooling/scripts/free-dev-ports.mjs",
    "start": "node tooling/scripts/dev-runner.mjs",
    "start:prod": "vite preview",
    "predev": "node tooling/scripts/free-dev-ports.mjs && node -e \"console.log('Starting Rally Forge dev environment...')\"",
    "dev": "node tooling/scripts/dev-runner.mjs",
    "dev:full": "node tooling/scripts/dev-runner.mjs --with-static",
    "dev:doctor": "node tooling/scripts/dev-doctor.mjs",
    "dev:web": "http-server app/frontend-modern -p 5174 -c-1",
    "dev:api": "node backend/server.js",
    "dev:react": "vite",
    "build": "vite build",
    "build:check": "npm run build && node -e \"console.log('✅ Build successful')\"",
    "preview": "vite preview",
    "test": "echo 'Running all tests...' && npm run test:strs-engine && npm run test:strs-integration && npm run test:compensation && npm run test:dependents",
    "test:strs-engine": "node tests/treatment/strs-engine.test.js",
    "test:strs-integration": "node tests/treatment/strs-integration.test.js",
    "test:strs-precision": "node --test tests/treatment/strs-event-precision.test.js",
    "test:api-smoke": "node tooling/scripts/run-api-smoke-with-server.mjs",
    "test:analyzer-derivations": "node --test tests/analyzer/workspace-derivations.secondary-mode.test.js",
    "test:analyzer-snapshots": "node --test tests/analyzer/workspace-derivations.snapshot.test.js",
    "test:profile-editor-state": "node --test tests/profile/profile-editor-state.test.js",
    "test:profile-navigation-guard": "node --test tests/profile/profile-navigation-guard.test.js",
    "test:profile-ui": "vitest run --config vite.config.js app/frontend-modern/src/tests/profile-page.interactions.test.jsx",
    "test:strs-feedback-ui": "node tooling/scripts/run-vitest-feedback-safe.mjs",
    "test:scanner-benchmark": "node tooling/scripts/scanner-benchmark.mjs",
    "test:pattern": "node tests/test-pattern-match.js",
    "test:onboarding-flow": "node tooling/scripts/verify-onboarding-flow.mjs",
    "test:compensation": "node --test tests/benefits/compensation-regression.test.js",
    "test:dependents": "node --test tests/benefits/dependent-calculation.test.js",
    "ci:install": "npm ci",
    "ci:bootstrap": "npm run ci:validate:environment && npm run ci:validate:schema",
    "ci:validate:environment": "node tooling/scripts/ci-validate-environment.mjs",
    "ci:validate:schema": "node tooling/scripts/ci-validate-schemas.mjs",
    "ci:lint": "eslint app/frontend-modern/src backend --ext .js,.jsx --quiet",
    "ci:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "ci:static": "node tooling/scripts/ci-static-guard.mjs",
    "ci:unit": "node tooling/scripts/ci-run-vitest-group.mjs unit",
    "ci:integration": "node tooling/scripts/ci-run-vitest-group.mjs integration",
    "ci:e2e": "node tooling/scripts/ci-run-vitest-group.mjs e2e",
    "ci:file-audit": "node tooling/scripts/ci-file-audit.mjs",
    "ci:quality:snapshot": "node tooling/scripts/ci-quality-snapshot.mjs",
    "ci:quality:enforce-baseline": "node tooling/scripts/ci-enforce-quality-baseline.mjs",
    "ci:build": "npm run build",
    "ci:package:validate": "node -e \"const fs=require('fs'); const candidates=['app/frontend-modern/dist','dist']; if(!candidates.some((p)=>fs.existsSync(p))){process.exit(1)}; console.log('BUILD ARTIFACTS VALIDATED')\"",
    "ci:deploy-gate": "npm run ci:lint && npm run ci:typecheck && npm run ci:validate:schema && npm run ci:unit && npm run ci:integration && npm run ci:e2e && npm run ci:file-audit && npm run ci:build && npm run ci:package:validate",
    "audit:refs": "node tooling/scripts/audit-missing-refs.mjs",
    "test:fast": "npm run test:strs-precision && npm run test:strs-engine && npm run test:strs-integration",
    "test:core-regression": "npm run test:fast && npm run test:strs-engine && npm run test:api-smoke && npm run test:strs-feedback-ui",
    "validate:industrial": "npm run build && npm run test:core-regression && npm run test:scanner-benchmark",
    "validate:rate-database": "node \"backend/va_scanner/rates/MANIFESTS/validate-rate-database.mjs\"",
    "validate:rate-database:strict": "node \"backend/va_scanner/rates/MANIFESTS/validate-rate-database.mjs\" --strict",
    "validate:all": "npm run lint && npm run build:check && npm test && npm run test:scanner-regression && npm run test:onboarding-flow && npm run validate:rate-database:strict",
    "audit:security": "npm audit --production",
    "lint": "eslint app/frontend-modern/src backend --ext .js,.jsx --max-warnings 300",
    "lint:fix": "eslint app/frontend-modern/src backend --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node -e \"const fs=require('fs'); ['dist','node_modules','package-lock.json'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}})\"",
    "clean:build": "node -e \"const fs=require('fs'); try{fs.rmSync('dist',{recursive:true,force:true});}catch{}\"",
    "validate": "npm run format:check && npm run build:check",
    "sep:validate": "node docs/spd_engine/validate_inputs.js",
    "sep:extract": "node docs/spd_engine/run_extract.js",
    "test:dd214": "node --test tests/dd214/dd214-variants.test.js tests/dd214/dd214-deterministic.test.js tests/dd214/dd214-discharge-extraction.test.js tests/dd214/dd214-stepone-mapper.test.js tests/dd214/dd214-semantic-anchors.test.js tests/dd214/dd214-extraction-extended.test.js tests/dd214/dd214-legacy-hardening.test.js tests/dd214/dd214-regression-hardening.test.js",
    "validate:dd214-output": "node tooling/scripts/validate-dd214-output.mjs",
    "validate:dd214-corpus": "node tooling/scripts/validate-dd214-output-batch.mjs",
    "validate:dd214-import-workflow": "node tooling/scripts/verify-dd214-import-workflow.mjs",
    "test:current-treatment": "node --test tests/treatment/currentTreatment-engine.test.js",
    "test:scanner-regression": "node --test tests/scanner/deterministic-fusion.test.js tests/scanner/cfr-api-route.test.js tests/scanner/cfr-microservice.test.js",
    "audit:scanner-subsystem": "npm run test:scanner-regression && npm run test:scanner-benchmark",
    "audit:knowledge-subsystem": "node tooling/scripts/validate-cfr-knowledge.js",
    "cfr:build-index": "node tooling/scripts/build-cfr-index.js",
    "audit:benefits-subsystem": "npm run test:api-smoke",
    "passes:20": "node -e \"const {spawnSync}=require('child_process'); for(let i=1;i<=20;i++){console.log('\\n=== PASS '+i+' / 20 ==='); const r=spawnSync('npm',['run','audit:watchdog:once'],{stdio:'inherit',shell:true}); if(r.status!==0){process.exit(r.status||1);} } console.log('\\n20-pass audit complete.');\"",
    "watchdog:loop": "powershell -ExecutionPolicy Bypass -File run.ps1 -Mode Watchdog",
    "nightly:schedule": "powershell -ExecutionPolicy Bypass -File run.ps1 -Mode ScheduleNightlyAudit",
    "audit:watchdog:once": "eslint app/frontend-modern/src backend --ext .js,.jsx --max-warnings 1000 && npm run build && npm run test:core-regression && npm run audit:scanner-subsystem && npm run audit:strs-feedback",
    "audit:nightly": "npm run benefits:modernize && npm run audit:subsystems && npm run audit:watchdog:once && npm run audit:strs-precision && npm run audit:strs-feedback && npm run validate:rate-database:strict",
    "audit:subsystems": "node tooling/scripts/generate-subsystem-audits.mjs",
    "audit:metadata": "node tooling/scripts/audit-metadata-gate.mjs --pretty",
    "audit:metadata:strict": "node tooling/scripts/audit-metadata-gate.mjs --pretty --fail-on-warn",
    "audit:architecture": "node tooling/scripts/check-architecture-conformance.mjs",
    "audit:docs": "node tooling/scripts/check-canonical-md.mjs",
    "audit:placeholders": "node tooling/scripts/audit-placeholder-registry.mjs",
    "audit:strs-precision": "node tooling/scripts/strs-precision-report.mjs",
    "audit:strs-feedback": "node tooling/scripts/strs-feedback-report.mjs",
    "audit:full-system": "powershell -ExecutionPolicy Bypass -File scripts/full_system_audit.ps1",
    "audit:completeness": "powershell -ExecutionPolicy Bypass -File scripts/file_completeness_scanner.ps1",
    "audit:cleanup-plan": "powershell -ExecutionPolicy Bypass -File scripts/cleanup_plan_generator.ps1",
    "audit:command-center": "npm run audit:full-system && npm run audit:completeness && npm run audit:cleanup-plan",
    "audit:modernization": "npm run audit:subsystems && npm run audit:metadata && npm run audit:architecture && npm run audit:docs",
    "audit:developer": "node tooling/scripts/dev-audit-assistant.mjs",
    "audit:developer:baseline": "node tooling/scripts/dev-audit-assistant.mjs --update-baseline",
    "audit:developer:strict": "node tooling/scripts/audit-developer-strict.mjs",
    "validate:urls": "node tooling/scripts/url-restoration-validator.mjs --pretty",
    "validate:urls:fix": "node tooling/scripts/url-restoration-validator.mjs --pretty --autofix",
    "test:post-cleanup": "node tooling/scripts/post-cleanup-regression.mjs",
    "audit:duplicates:plan": "node tooling/scripts/generate-safe-delete-plan.mjs",
    "audit:md:upgrade": "node tooling/scripts/md-quality-upgrade.mjs --apply",
    "audit:passes:15": "node tooling/scripts/run-15-audit-passes.mjs",
    "benefits:modernize": "node tooling/scripts/generate-benefits-modernization.mjs",
    "mos:exposure-map": "node scripts/generate-mos-exposure-risk-map.mjs",
    "benefits:watchdog": "node tooling/scripts/benefits-watchdog.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "canvas": "^3.2.1",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "mongodb": "^6.10.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pdf-to-img": "^5.0.0",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "prop-types": "^15.8.1",
    "redis": "^5.11.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
