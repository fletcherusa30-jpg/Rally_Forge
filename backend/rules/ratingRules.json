{
  "version": "1.1.0",
  "effectiveDate": "2026-02-01",
  "source": "Rally Forge curated baseline",
  "metadata": {
    "category": "rating"
  },
  "rules": [
    {
      "id": "rating-priority-group",
      "description": "Higher ratings impact priority group",
      "tags": ["healthcare"],
      "conditions": [
        { "field": "disabilityRatingKnown", "operator": "eq", "value": true },
        { "field": "disabilityRatingPercent", "operator": "gte", "value": 50 }
      ],
      "outcomes": [
        {
          "title": "Priority Group 1-3 review",
          "description": "Higher ratings may qualify you for lower copays and priority care.",
          "link": "https://www.va.gov/health-care/eligibility/priority-groups/",
          "tags": ["rating", "healthcare"]
        }
      ]
    },
    {
      "id": "rating-compensation-review",
      "description": "Compensation review for rated veterans",
      "tags": ["compensation"],
      "conditions": [
        { "field": "disabilityRatingKnown", "operator": "eq", "value": true },
        { "field": "disabilityRatingPercent", "operator": "gte", "value": 10 }
      ],
      "outcomes": [
        {
          "title": "Monthly compensation review",
          "description": "Confirm compensation rates and potential increases.",
          "link": "https://www.va.gov/disability/compensation-rates/",
          "tags": ["rating", "compensation"]
        }
      ]
    }
  ]
}
