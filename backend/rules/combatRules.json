{
  "version": "1.1.0",
  "effectiveDate": "2026-02-01",
  "source": "Rally Forge curated baseline",
  "metadata": {
    "category": "combat"
  },
  "rules": [
    {
      "id": "combat-va-claims",
      "description": "Combat veterans claims assistance",
      "tags": ["claims"],
      "conditions": [
        { "field": "combatSelfReported", "operator": "eq", "value": "yes" }
      ],
      "outcomes": [
        {
          "title": "Priority claims support",
          "description": "Combat veterans may qualify for priority processing of VA claims.",
          "link": "https://www.va.gov/disability/",
          "tags": ["claims", "combat"]
        }
      ],
      "notes": "Collect documentation on deployments and combat awards if available."
    },
    {
      "id": "combat-mentoring",
      "description": "Peer support and mentorship",
      "tags": ["wellness"],
      "conditions": [
        { "field": "combatSelfReported", "operator": "eq", "value": "not_sure" }
      ],
      "outcomes": [
        {
          "title": "Combat veteran peer support",
          "description": "Speak with a peer mentor to review eligibility and next steps.",
          "link": "https://www.va.gov/health-care/health-needs-conditions/mental-health/",
          "tags": ["wellness", "combat"]
        }
      ]
    },
    {
      "id": "combat-vet-centers",
      "description": "Vet Center counseling resources",
      "tags": ["counseling"],
      "conditions": [
        { "field": "combatSelfReported", "operator": "eq", "value": "yes" }
      ],
      "outcomes": [
        {
          "title": "Vet Center counseling services",
          "description": "Access counseling, readjustment services, and community care through Vet Centers.",
          "link": "https://www.vetcenter.va.gov/",
          "tags": ["counseling", "combat"]
        }
      ]
    }
  ]
}
