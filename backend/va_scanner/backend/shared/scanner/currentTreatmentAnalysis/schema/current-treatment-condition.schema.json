{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Current Treatment Condition Schema",
  "description": "Defines structure of active medical conditions extracted from clinical documentation",
  "type": "object",
  "properties": {
    "conditionId": {
      "type": "string",
      "pattern": "^COND-[0-9]{6}$"
    },
    "conditionName": {
      "type": "string"
    },
    "icd10Code": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}(\\.\\d{1,4})?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "chronic",
        "resolved",
        "controlled",
        "uncontrolled"
      ]
    },
    "lastEncounterDate": {
      "type": "string",
      "format": "date"
    },
    "durationMonths": {
      "type": "integer",
      "minimum": 0
    },
    "treatmentModalities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "medication",
          "physical-therapy",
          "mental-health",
          "surgery",
          "lifestyle-modification",
          "monitoring"
        ]
      }
    },
    "functionalImpact": {
      "type": "object",
      "properties": {
        "impactLevel": {
          "type": "string",
          "enum": [
            "none",
            "mild",
            "moderate",
            "severe",
            "total"
          ]
        },
        "affectedActivities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workability": {
          "type": "string",
          "enum": [
            "full-duty",
            "light-duty",
            "limited",
            "unable-to-work"
          ]
        }
      }
    },
    "severity": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "mild",
            "moderate",
            "severe"
          ]
        },
        "trend": {
          "type": "string",
          "enum": [
            "improving",
            "stable",
            "worsening"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "conditionId",
    "conditionName"
  ]
}
