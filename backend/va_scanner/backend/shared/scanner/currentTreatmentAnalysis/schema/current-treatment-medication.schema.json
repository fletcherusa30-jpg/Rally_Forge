{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Current Treatment Medication Schema",
  "description": "Defines structure of medications and treatments extracted from clinical documentation",
  "type": "object",
  "properties": {
    "medicationId": {
      "type": "string",
      "pattern": "^MED-[0-9]{6}$"
    },
    "drugName": {
      "type": "string"
    },
    "genericName": {
      "type": "string"
    },
    "ndc": {
      "type": "string",
      "pattern": "^\\d{5}-\\d{4}-\\d{2}$"
    },
    "dosage": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "mg",
            "g",
            "mcg",
            "IU",
            "mL",
            "units"
          ]
        }
      }
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "IV",
        "IM",
        "SQ",
        "topical",
        "inhalation",
        "rectal",
        "transdermal",
        "sublingual"
      ]
    },
    "frequency": {
      "type": "string",
      "enum": [
        "OD",
        "BID",
        "TID",
        "QID",
        "Q4H",
        "Q6H",
        "Q8H",
        "Q12H",
        "QHS",
        "PRN",
        "weekly",
        "monthly"
      ]
    },
    "indication": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "discontinued",
        "changed",
        "as-needed"
      ]
    },
    "adherence": {
      "type": "string",
      "enum": [
        "excellent",
        "good",
        "fair",
        "poor",
        "unknown"
      ]
    },
    "sideEffects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "medicationId",
    "drugName",
    "dosage",
    "route",
    "frequency"
  ]
}
