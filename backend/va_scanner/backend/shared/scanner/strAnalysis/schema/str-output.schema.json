{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STR Scanner Output Schema",
  "description": "Complete output from STR scanner including encounters, exposures, and timeline",
  "type": "object",
  "properties": {
    "_metadata": {
      "type": "object",
      "properties": {
        "scannerId": {
          "type": "string"
        },
        "scanDate": {
          "type": "string",
          "format": "date-time"
        },
        "documentType": {
          "type": "string",
          "enum": [
            "chronological-str",
            "deployment-haq",
            "hospitalization-summary",
            "occupational-health",
            "other"
          ]
        },
        "encounterCount": {
          "type": "integer",
          "minimum": 0
        },
        "exposuresDetected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chronicityScores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "confidence": {
          "type": "object",
          "properties": {
            "overall": {
              "type": "number"
            },
            "byField": {
              "type": "object"
            }
          }
        },
        "validationWarnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "encounters": {
      "type": "array",
      "items": {
        "$ref": "str-encounter.schema.json"
      }
    },
    "exposures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "chemical",
              "radiation",
              "biological",
              "environmental",
              "occupational"
            ]
          },
          "name": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "unit": {
            "type": "string"
          },
          "estimatedDuration": {
            "type": "string"
          },
          "serviceConnectionRelevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "chronicity": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "firstEncounterDate": {
            "type": "string",
            "format": "date"
          },
          "lastEncounterDate": {
            "type": "string",
            "format": "date"
          },
          "encounterCount": {
            "type": "integer"
          },
          "isChronicByCount": {
            "type": "boolean"
          },
          "chronicityScore": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "properties": {
        "serviceStart": {
          "type": "string",
          "format": "date"
        },
        "serviceEnd": {
          "type": "string",
          "format": "date"
        },
        "documentCoverageStart": {
          "type": "string",
          "format": "date"
        },
        "documentCoverageEnd": {
          "type": "string",
          "format": "date"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string",
                "format": "date"
              },
              "duration": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "_metadata",
    "encounters"
  ]
}
