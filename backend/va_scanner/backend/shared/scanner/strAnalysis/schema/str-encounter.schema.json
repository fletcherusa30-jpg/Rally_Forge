{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STR Encounter Record Schema",
  "description": "Defines structure of individual medical encounters extracted from STR documents",
  "type": "object",
  "properties": {
    "encounterId": {
      "type": "string",
      "pattern": "^STR-[0-9]{4}-[0-9]{6}$"
    },
    "encounterDate": {
      "type": "string",
      "format": "date"
    },
    "encounterType": {
      "type": "string",
      "enum": [
        "sick-call",
        "hospitalization",
        "surgery",
        "mental-health",
        "field-medical",
        "immunization",
        "profile-evaluation",
        "consultation",
        "other"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "deployment": {
          "type": "boolean"
        }
      }
    },
    "provider": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "MD",
            "PA",
            "RN",
            "NP",
            "Flight-Surgeon",
            "Corpsman",
            "Other"
          ]
        },
        "specialty": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "chiefComplaint": {
      "type": "string"
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string"
        },
        "icd10Code": {
          "type": "string",
          "pattern": "^[A-Z][0-9]{2}(\\.\\d{1,4})?$"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "confirmed",
            "rule-out",
            "probable"
          ]
        }
      }
    },
    "treatment": {
      "type": "string"
    },
    "dutyStatus": {
      "type": "string",
      "enum": [
        "full-duty",
        "limited-duty",
        "medical-hold",
        "cannot-deploy",
        "light-duty"
      ]
    },
    "lineOfDuty": {
      "type": "boolean"
    },
    "exposureIndicators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "encounterId",
    "encounterDate",
    "chiefComplaint"
  ]
}
