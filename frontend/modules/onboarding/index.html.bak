<section class="onboarding is-rating-fullscreen min-h-screen bg-gradient-to-br from-slate-50 to-slate-100" data-onboarding>
  <link rel="stylesheet" href="modules/common/module.css" />
  <link rel="stylesheet" href="modules/onboarding/module.css" />
  <script src="https://cdn.tailwindcss.com"></script>

  <div class="px-4 sm:px-6 py-8 sm:py-12">
    <div class="max-w-4xl mx-auto bg-white shadow-lg rounded-lg p-8 sm:p-10">
      <header class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6 pb-8 border-b border-slate-200">
        <div class="flex-1">
          <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 tracking-tight">Rally Forge</h1>
          <p class="text-slate-600 text-base sm:text-lg mt-3 leading-relaxed">Build your profile in a few simple steps to unlock personalized benefits and insights.</p>
        </div>

        <div class="w-full sm:w-auto sm:min-w-[200px]">
          <div class="flex gap-2" role="progressbar" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" aria-label="Overall progress">
            <div class="h-2.5 flex-1 sm:w-12 bg-blue-600 rounded-full"></div>
            <div class="h-2.5 flex-1 sm:w-12 bg-slate-200 rounded-full"></div>
            <div class="h-2.5 flex-1 sm:w-12 bg-slate-200 rounded-full"></div>
            <div class="h-2.5 flex-1 sm:w-12 bg-slate-200 rounded-full"></div>
          </div>
          <p class="text-slate-500 text-sm font-medium mt-3 text-right">Step 1 of 4</p>
        </div>
      </header>

      <form id="onboarding-form" novalidate class="mt-6 space-y-6">
      <!-- Step 0: Branch, Service, and Combat -->
      <section class="step active" data-step="0">
        <div class="space-y-6">
          <div class="pt-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Military Service Information</h2>
            <p class="text-slate-600 mt-2">Please provide details about your military service history.</p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div class="step-column space-y-6">
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
                <label class="block">
                  <span class="block text-sm font-semibold text-slate-700 mb-3">Branch of Service</span>
                  <select name="branch" required aria-describedby="branch-hint" class="w-full px-4 py-3 text-base bg-white text-slate-900 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"></select>
                  <span class="hint text-slate-500 text-sm mt-2 block" id="branch-hint">Select your primary branch of military service.</span>
                </label>
              </div>

              <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
                <label class="block">
                  <span class="block text-sm font-semibold text-slate-700 mb-3">Service Component</span>
                  <select name="component" required aria-describedby="component-hint" class="w-full px-4 py-3 text-base bg-white text-slate-900 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"></select>
                  <span class="hint text-white/70 text-xs mt-2 block" id="component-hint">Active duty, reserve, or guard.</span>
                </label>
              </div>

              <div class="bg-[#14180F] border border-white/10 rounded-sm p-4">
                <fieldset class="space-y-3">
                  <legend class="text-sm font-semibold">Did you serve in combat operations?</legend>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="combatSelfReported" value="yes" class="w-4 h-4" />
                    <span class="text-sm">Yes</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="combatSelfReported" value="no" class="w-4 h-4" />
                    <span class="text-sm">No</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="combatSelfReported" value="not_sure" class="w-4 h-4" />
                    <span class="text-sm">Not sure</span>
                  </label>
                </fieldset>
              </div>
            </div>

            <div class="step-column space-y-4">
              <div class="bg-[#14180F] border border-white/10 rounded-sm p-4">
                <h3 class="text-sm font-semibold mb-2">Service Periods</h3>
                <p class="text-white/70 text-sm mb-4">List every continuous period of service. Add more if you had breaks.</p>
                <div id="service-periods" class="service-periods space-y-4"></div>
                <button type="button" class="mt-4 px-5 py-2.5 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-md hover:bg-blue-100 transition-colors" data-add-period>+ Add Another Period</button>
              </div>

              <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
                <div class="mb-4">
                  <div class="text-base font-semibold text-slate-900">Awards and Decorations</div>
                  <p class="text-slate-600 text-sm mt-1">DD-214 Block 13 — Awards help match combat and exposure-related benefits.</p>
                </div>
                <div class="flex gap-3">
                  <select id="awards-select" name="awards" aria-describedby="awards-hint" aria-label="Awards and decorations" class="flex-1 px-4 py-3 text-base bg-white text-slate-900 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"></select>
                  <button type="button" class="px-5 py-3 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors" data-awards-add>Add Award</button>
                </div>
                <div class="awards-selected mt-4 space-y-2" data-awards-selected aria-live="polite"></div>
                <span class="hint text-slate-500 text-sm mt-3 block" id="awards-hint">Select an award from the list, then click Add Award. Repeat to add multiple awards.</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 1: Disability Rating -->
      <section class="step" data-step="1">
        <div class="space-y-6">
          <div class="pt-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">VA Disability Rating</h2>
            <p class="text-slate-600 text-base mt-2">Upload your VA decision letter for automatic extraction, or enter your conditions manually.</p>
          </div>

          <div class="rating-tools" data-rating-tools>
            <div class="rating-tools-header flex items-center justify-between mb-6">
              <h3 class="text-lg font-semibold text-slate-900">Rating Tools</h3>
              <button type="button" class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 border border-slate-200 rounded-md hover:bg-slate-200 transition-colors" data-rating-toggle aria-expanded="true">Collapse</button>
            </div>

            <div class="rating-tools-content" data-rating-content>
              <div class="rating-mode-tabs grid grid-cols-1 md:grid-cols-2 gap-4 mb-6" role="tablist">
                <button type="button" class="rating-mode-tab is-active text-left px-6 py-5 border-2 border-blue-600 rounded-lg bg-blue-50 hover:bg-blue-100 transition-all" data-rating-mode="scanner" role="tab" aria-selected="true">
                  <div class="text-base font-semibold text-slate-900">Document Scanner</div>
                  <p class="text-slate-600 text-sm mt-2">Upload your VA decision letter for automatic extraction.</p>
                </button>
                <button type="button" class="rating-mode-tab text-left px-6 py-5 border-2 border-slate-200 rounded-lg bg-white hover:bg-slate-50 transition-all" data-rating-mode="manual" role="tab" aria-selected="false">
                  <div class="text-base font-semibold text-slate-900">Manual Entry</div>
                  <p class="text-slate-600 text-sm mt-2">Enter each condition and rating percentage manually.</p>
                </button>
              </div>

              <div class="rating-mode-panels">
                <div class="rating-mode-panel is-active bg-slate-50 border border-slate-200 rounded-lg p-6" data-rating-panel="scanner" role="tabpanel">
                  <div class="rating-upload space-y-5">
                    <h4 class="text-base font-semibold text-slate-900">Decision Letter Upload</h4>
                    <input type="file" id="rating-upload-input" data-rating-upload aria-label="Upload rating decision letter" accept=".txt,.md,.rtf,.pdf" data-rf-scoped-scanner="true">
                    <label for="rating-upload-input" class="rating-file block p-8 border-2 border-dashed border-slate-300 text-center cursor-pointer rounded-lg bg-white hover:bg-slate-50 hover:border-blue-400 transition-all">
                      <p class="text-base font-medium text-slate-900">Drop your decision letter here or click to browse</p>
                      <p class="text-slate-500 text-sm mt-2">Supports PDF and text files up to 5 MB</p>
                    </label>
                    <div class="rating-disabilities hidden" data-rating-disabilities></div>
                    <button type="button" class="px-5 py-2.5 text-sm font-medium text-red-600 bg-red-50 border border-red-200 rounded-md hover:bg-red-100 transition-colors" data-rating-remove>Remove Document</button>
                  </div>
                </div>

                <div class="rating-mode-panel bg-slate-50 border border-slate-200 rounded-lg p-6" data-rating-panel="manual" role="tabpanel">
                  <div class="rating-calc space-y-5">
                    <h4 class="text-base font-semibold text-slate-900">Combined Rating Calculator</h4>
                    <p class="text-slate-600 text-sm">Add each service-connected condition with its VA rating percentage.</p>
                    <button type="button" class="px-5 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors" data-rating-add onclick="window.RFAddContention && window.RFAddContention()">
                      Add Condition
                    </button>
                    <div class="rating-list space-y-3" data-rating-list></div>
                    <div class="bg-gradient-to-br from-blue-50 to-blue-100 border-2 border-blue-200 rounded-lg p-6 text-center">
                      <div class="text-slate-600 text-sm font-medium">Combined VA Rating</div>
                      <div class="text-4xl font-bold text-blue-600 mt-2"><span data-rating-combined>0</span>%</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Step 2: State of Residence -->
      <section class="step" data-step="2">
        <div class="space-y-6">
          <div class="pt-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">State of Residence</h2>
            <p class="text-slate-600 text-base mt-2">This helps us identify state-specific benefits and programs available to you.</p>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
            <label class="block">
              <span class="block text-sm font-semibold text-slate-700 mb-3">State or Territory</span>
              <select name="stateOfReslate-500 text-sm mt-2 block" id="state-hint">Your current state of residence for benefits eligibility.</span>
            </label>
          </div>
        </div>
      </section>

      <!-- Step 3: Summary -->
      <section class="step" data-step="3">
        <div class="space-y-6">
          <div class="pt-6">
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900">Review Your Information</h2>
            <p class="text-slate-600 text-base mt-2">Please review your information before submitting.</p>
          </div>
          <div class="summary bg-slate-50 border border-slate-200 rounded-lg p-6
          <div class="summary" data-summary role="region" aria-live="polite"></div>
        </div>
      </section>
      <footer class="flex items-center justify-between gap-4 pt-8 mt-6 border-t border-slate-200">
        <button type="button" class="px-6 py-3 text-base font-medium text-slate-600 bg-white border border-slate-300 rounded-md hover:bg-slate-50 transition-colors disabled:opacity-50 disabled:cursor-not-allowed" data-prev onclick="window.RFOnboardingNav && window.RFOnboardingNav.prev && window.RFOnboardingNav.prev()">
          ← Back
        </button>
        <button type="button" class="px-6 py-3 text-base font-medium text-white bg-blue-600 rounded-md hover:bg-blue-700 transition-colors shadow-sm" data-next onclick="window.RFOnboardingNav && window.RFOnboardingNav.next && window.RFOnboardingNav.next()">
          Next →
        </button>
        <button type="submit" class="hidden px-6 py-3 text-base font-medium text-white bg-green-600 rounded-md hover:bg-green-700 transition-colors shadow-sm" data-submit>
          Submit Profile
        </button>
      </footer>
    </form>

    <div class="status hidden text-center py-4" data-status role="status" aria-live="polite"></div>
    </div>
  </div>
</section>
